generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContentEntry {
  id           String        @id @default(cuid())
  date         DateTime      @unique
  category     String
  topic        String
  linkedinPost String?
  imagePath    String?
  status       String        @default("PENDING")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([category])
  @@index([topic])
}
